generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  domain      String?  @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  users        User[]
  patients     Patient[]
  appointments Appointment[]
  medicines    Medicine[]
  billings     Billing[]
}

model User {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  email          String        @unique
  passwordHash   String
  role           Role          @default(STAFF)
  department     String?
  phone          String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  
  organization   Organization  @relation(fields: [organizationId], references: [id])
  appointments   Appointment[] @relation("DoctorAppointments")
}

model Patient {
  id             String        @id @default(uuid())
  organizationId String
  patientCode    String
  name           String
  age            Int
  gender         String
  bloodGroup     String?
  contactNumber  String
  email          String?
  address        String?
  medicalHistory String?
  createdAt      DateTime      @default(now())
  
  organization   Organization  @relation(fields: [organizationId], references: [id])
  appointments   Appointment[]
  vitals         Vitals[]

  @@unique([organizationId, patientCode])
}

model Appointment {
  id              String    @id @default(uuid())
  organizationId  String
  patientId       String
  doctorId        String?
  appointmentDate DateTime
  timeSlot        String
  tokenNumber     Int       @default(autoincrement())
  status          ApptStatus @default(PENDING)
  
  organization    Organization @relation(fields: [organizationId], references: [id])
  patient         Patient   @relation(fields: [patientId], references: [id])
  doctor          User?     @relation("DoctorAppointments", fields: [doctorId], references: [id])
  vitals          Vitals?
  billing         Billing?
}

model Vitals {
  id             String      @id @default(uuid())
  appointmentId  String      @unique
  patientId      String
  bpSystolic     Int?
  bpDiastolic    Int?
  pulseBpm       Int?
  weightKg       Float?
  temperature    Float?
  symptoms       String?
  doctorNotes    String?
  createdAt      DateTime    @default(now())

  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  patient        Patient     @relation(fields: [patientId], references: [id])
}

model Medicine {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  genericName      String?
  batchNo          String
  stockQuantity    Int      @default(0)
  unitPrice        Float
  expiryDate       DateTime
  reorderThreshold Int      @default(50)

  organization     Organization @relation(fields: [organizationId], references: [id])
}

model Billing {
  id                String      @id @default(uuid())
  organizationId    String
  invoiceNo         String
  appointmentId     String      @unique
  consultationFee   Float       @default(0)
  medicineCharges   Float       @default(0)
  totalAmount       Float
  discount          Float       @default(0)
  paymentStatus     PayStatus   @default(UNPAID)
  paymentMethod     String?
  
  organization      Organization @relation(fields: [organizationId], references: [id])
  appointment       Appointment  @relation(fields: [appointmentId], references: [id])

  @@unique([organizationId, invoiceNo])
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  DOCTOR
  RECEPTIONIST
  PHARMACIST
  STAFF
  VIEWER
}

enum ApptStatus {
  PENDING
  ARRIVED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
}

enum PayStatus {
  PAID
  UNPAID
  PARTIAL
}

model Transaction {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  description String
  type        TxType   @default(INCOME)
  amount      Float
  category    String?  // Consultation, Pharmacy, Restock, Supplies, Salary, Utility
  paymentMode String?  // Cash, Card, UPI, Bank Transfer
  createdAt   DateTime @default(now())
}

enum TxType {
  INCOME
  EXPENSE
}
