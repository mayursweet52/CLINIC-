generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  domain        String?  @unique
  logoUrl       String?
  coverImageUrl String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  phone         String?
  latitude      Float?
  longitude     Float?
  rating        Float    @default(0)
  totalReviews  Int      @default(0)
  isActive      Boolean  @default(true)
  plan          String?  @default("FREE")
  settings      Json?
  createdAt     DateTime @default(now())

  users         User[]
  patients      Patient[]
  appointments  HealthAppointment[]
  visits        PatientVisit[]
  prescriptions Prescription[]
  labReports    LabReport[]

  medicines      Medicine[]
  billings       Billing[]
  availabilities DoctorAvailability[]
  timeOffs       DoctorTimeOff[]

  departments   Department[]
  reviews       Review[]
  inventoryLogs InventoryLog[]
}

model User {
  id             String   @id @default(uuid())
  organizationId String?
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(RECEPTIONIST)
  department     String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  specialization  String?
  registrationNo  String?
  consultationFee Float?
  availableDays   String[]
  slotDuration    Int?

  bio               String?
  yearsOfExperience Int?
  averageRating     Float   @default(0)
  totalReviews      Int     @default(0)

  organization   Organization?        @relation(fields: [organizationId], references: [id])
  appointments   HealthAppointment[]  @relation("DoctorAppointments")
  visits         PatientVisit[]       @relation("DoctorVisits")
  prescriptions  Prescription[]       @relation("DoctorPrescriptions")
  availabilities DoctorAvailability[] @relation("DoctorAvailability")
  timeOffs       DoctorTimeOff[]      @relation("DoctorTimeOff")

  departments     DoctorDepartment[]
  reviewsReceived Review[]           @relation("DoctorReviews")
  inventoryLogs   InventoryLog[]
  profile         DoctorProfile?
}

model DoctorProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  specialization  String?
  licenseNumber   String?
  consultationFee Float?
  bio             String?
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Patient {
  id               String    @id @default(uuid())
  organizationId   String
  patientCode      String
  name             String
  phone            String
  email            String?
  passwordHash     String?
  address          String?
  dob              DateTime?
  gender           String
  bloodGroup       String?
  allergies        String[]
  chronicConds     String[]
  emergencyContact String?
  createdAt        DateTime  @default(now())

  organization  Organization        @relation(fields: [organizationId], references: [id])
  appointments  HealthAppointment[]
  visits        PatientVisit[]
  labReports    LabReport[]
  prescriptions Prescription[]
  reviews       Review[]

  @@unique([organizationId, patientCode])
}

model HealthAppointment {
  id              String     @id @default(uuid())
  organizationId  String
  patientId       String
  doctorId        String?
  appointmentNo   String?
  appointmentDate DateTime
  timeSlot        String
  tokenNumber     Int        @default(0)
  tokenDisplay    String     @default("")
  publicToken     String     @unique @default(cuid())
  qrCode          String?
  status          ApptStatus @default(SCHEDULED)
  reason          String?
  fee             Float?
  isPaid          Boolean    @default(false)
  createdAt       DateTime   @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  doctor       User?         @relation("DoctorAppointments", fields: [doctorId], references: [id])
  visit        PatientVisit?
  billing      Billing?
  review       Review?
}

model PatientVisit {
  id             String   @id @default(uuid())
  organizationId String
  patientId      String
  doctorId       String?
  appointmentId  String   @unique
  visitDate      DateTime @default(now())

  vitalsBP     String?
  vitalsPulse  Int?
  vitalsTemp   Float?
  vitalsWeight Float?

  chiefComplaint String?
  diagnosis      String?
  notes          String?
  followUpDate   DateTime?

  organization  Organization      @relation(fields: [organizationId], references: [id])
  patient       Patient           @relation(fields: [patientId], references: [id])
  doctor        User?             @relation("DoctorVisits", fields: [doctorId], references: [id])
  appointment   HealthAppointment @relation(fields: [appointmentId], references: [id])
  prescriptions Prescription[]
}

model Prescription {
  id             String  @id @default(uuid())
  organizationId String
  patientId      String
  visitId        String?
  doctorId       String?

  medicines    Json
  diet         String?
  instructions String?
  validUntil   DateTime?
  status       String    @default("PENDING")
  dispensedAt  DateTime?
  createdAt    DateTime  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  visit        PatientVisit? @relation(fields: [visitId], references: [id])
  doctor       User?         @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
}

model LabReport {
  id             String   @id @default(uuid())
  organizationId String
  patientId      String
  testName       String
  results        Json?
  normalRange    String?
  interpretation String?
  fileUrl        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
}

enum Role {
  SUPERADMIN
  DOCTOR
  RECEPTIONIST
  PHARMACIST
  ADMIN
}

enum ApptStatus {
  SCHEDULED
  PENDING
  CONFIRMED
  ARRIVED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
}

enum PayStatus {
  PAID
  UNPAID
  PARTIAL
}

model Medicine {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  genericName      String?
  batchNo          String
  stockQuantity    Int      @default(0)
  unitPrice        Float
  expiryDate       DateTime
  reorderThreshold Int      @default(50)

  organization Organization   @relation(fields: [organizationId], references: [id])
  logs         InventoryLog[]
}

model Billing {
  id                String    @id @default(uuid())
  organizationId    String
  invoiceNo         String
  appointmentId     String    @unique
  consultationFee   Float     @default(0)
  medicineCharges   Float     @default(0)
  totalAmount       Float
  discount          Float     @default(0)
  paymentStatus     PayStatus @default(UNPAID)
  paymentMethod     String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id])
  appointment  HealthAppointment @relation(fields: [appointmentId], references: [id])

  @@unique([organizationId, invoiceNo])
}

model Transaction {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  description String
  type        TxType   @default(INCOME)
  amount      Float
  category    String?
  paymentMode String?
  createdAt   DateTime @default(now())
}

enum TxType {
  INCOME
  EXPENSE
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  category    String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  orgId      String?
  action     String
  resource   String
  resourceId String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model NotificationLog {
  id        String    @id @default(cuid())
  orgId     String
  channel   String
  to        String
  template  String
  payload   Json
  status    String    @default("PENDING")
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())
}

model DoctorAvailability {
  id           String   @id @default(uuid())
  doctorId     String
  dayOfWeek    Int
  startTime    String
  endTime      String
  slotDuration Int      @default(15)
  isActive     Boolean  @default(true)
  orgId        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor User          @relation("DoctorAvailability", fields: [doctorId], references: [id])
  org    Organization? @relation(fields: [orgId], references: [id])

  @@unique([doctorId, dayOfWeek])
}

model DoctorTimeOff {
  id        String   @id @default(uuid())
  doctorId  String
  date      DateTime
  reason    String?
  orgId     String
  createdAt DateTime @default(now())

  doctor User         @relation("DoctorTimeOff", fields: [doctorId], references: [id])
  org    Organization @relation(fields: [orgId], references: [id])

  @@unique([doctorId, date])
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  icon           String?
  isActive       Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctors      DoctorDepartment[]
  conditions   Condition[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model DoctorDepartment {
  doctorId     String
  departmentId String
  doctor       User       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([doctorId, departmentId])
}

model Condition {
  id           String   @id @default(cuid())
  name         String
  slug         String
  departmentId String
  icon         String?
  keywords     String[]

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, slug])
}

model Review {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  doctorId       String
  appointmentId  String   @unique
  rating         Int
  comment        String?
  isPublic       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       User              @relation("DoctorReviews", fields: [doctorId], references: [id])
  appointment  HealthAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([doctorId, isPublic])
  @@index([organizationId])
}

model InventoryLog {
  id             String   @id @default(cuid())
  organizationId String
  itemId         String
  action         String
  quantity       Int
  reference      String?
  userId         String
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         Medicine     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, itemId])
  @@index([createdAt])
}
