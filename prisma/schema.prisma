generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique
  address   String?
  city      String?
  state     String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users         User[]
  patients      Patient[]
  appointments  HealthAppointment[]
  visits        PatientVisit[]
  prescriptions Prescription[]
  labReports    LabReport[]

  // Existing models for generic features
  medicines       Medicine[]
  billings        Billing[]
  availabilities  DoctorAvailability[]
  timeOffs        DoctorTimeOff[]
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(STAFF)
  department     String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  // --- DOCTOR SPECIFIC FIELDS (Requested by User) ---
  specialization  String?
  registrationNo  String?
  consultationFee Float?
  availableDays   String[] // e.g. ["MONDAY", "WEDNESDAY"]
  slotDuration    Int? // e.g. 15

  organization    Organization          @relation(fields: [organizationId], references: [id])
  appointments    HealthAppointment[]   @relation("DoctorAppointments")
  visits          PatientVisit[]        @relation("DoctorVisits")
  prescriptions   Prescription[]        @relation("DoctorPrescriptions")
  availabilities  DoctorAvailability[]  @relation("DoctorAvailability")
  timeOffs        DoctorTimeOff[]       @relation("DoctorTimeOff")
}

model Patient {
  id               String    @id @default(uuid())
  organizationId   String
  patientCode      String
  name             String
  phone            String
  email            String?
  passwordHash     String?
  address          String?
  dob              DateTime?
  gender           String
  bloodGroup       String?
  allergies        String[]
  chronicConds     String[]
  emergencyContact String?
  createdAt        DateTime  @default(now())

  organization  Organization        @relation(fields: [organizationId], references: [id])
  appointments  HealthAppointment[]
  visits        PatientVisit[]
  labReports    LabReport[]
  prescriptions Prescription[]

  @@unique([organizationId, patientCode])
}

model HealthAppointment {
  id              String     @id @default(uuid())
  organizationId  String
  patientId       String
  doctorId        String?
  appointmentNo   String? // e.g. APT-001
  appointmentDate DateTime
  timeSlot        String
  tokenNumber     Int        @default(autoincrement())
  status          ApptStatus @default(SCHEDULED)
  fee             Float?
  isPaid          Boolean    @default(false)
  createdAt       DateTime   @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  doctor       User?         @relation("DoctorAppointments", fields: [doctorId], references: [id])
  visit        PatientVisit?
  billing      Billing?
}

model PatientVisit {
  id             String   @id @default(uuid())
  organizationId String
  patientId      String
  doctorId       String?
  appointmentId  String   @unique
  visitDate      DateTime @default(now())

  // Vitals
  vitalsBP     String?
  vitalsPulse  Int?
  vitalsTemp   Float?
  vitalsWeight Float?

  chiefComplaint String?
  diagnosis      String?
  notes          String?
  followUpDate   DateTime?

  organization  Organization      @relation(fields: [organizationId], references: [id])
  patient       Patient           @relation(fields: [patientId], references: [id])
  doctor        User?             @relation("DoctorVisits", fields: [doctorId], references: [id])
  appointment   HealthAppointment @relation(fields: [appointmentId], references: [id])
  prescriptions Prescription[]
}

model Prescription {
  id             String  @id @default(uuid())
  organizationId String
  patientId      String
  visitId        String?
  doctorId       String?

  medicines    Json // Detailed JSON struct containing medicines, dosages, etc.
  diet         String?
  instructions String?
  validUntil   DateTime?
  createdAt    DateTime  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  visit        PatientVisit? @relation(fields: [visitId], references: [id])
  doctor       User?         @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
}

model LabReport {
  id             String   @id @default(uuid())
  organizationId String
  patientId      String
  testName       String
  results        Json?
  normalRange    String?
  interpretation String?
  fileUrl        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
}

// ----------------------------------------------------
// KEEPING SUPPORTING ENUMS AND OTHER EXISTING MODELS
// ----------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  DOCTOR
  RECEPTIONIST
  PHARMACIST
  STAFF
  VIEWER
}

enum ApptStatus {
  SCHEDULED
  PENDING
  CONFIRMED
  ARRIVED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
}

enum PayStatus {
  PAID
  UNPAID
  PARTIAL
}

model Medicine {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  genericName      String?
  batchNo          String
  stockQuantity    Int      @default(0)
  unitPrice        Float
  expiryDate       DateTime
  reorderThreshold Int      @default(50)

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Billing {
  id              String    @id @default(uuid())
  organizationId  String
  invoiceNo       String
  appointmentId   String    @unique
  consultationFee Float     @default(0)
  medicineCharges Float     @default(0)
  totalAmount     Float
  discount        Float     @default(0)
  paymentStatus   PayStatus @default(UNPAID)
  paymentMethod   String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  paidAt            DateTime?
  createdAt       DateTime  @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id])
  appointment  HealthAppointment @relation(fields: [appointmentId], references: [id])

  @@unique([organizationId, invoiceNo])
}

model Transaction {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  description String
  type        TxType   @default(INCOME)
  amount      Float
  category    String?
  paymentMode String?
  createdAt   DateTime @default(now())
}

enum TxType {
  INCOME
  EXPENSE
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  category    String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  orgId       String?
  action      String
  resource    String
  resourceId  String?
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

model NotificationLog {
  id        String   @id @default(cuid())
  orgId     String
  channel   String   // email | sms | whatsapp
  to        String
  template  String
  payload   Json
  status    String   @default("PENDING") // PENDING | SENT | FAILED
  sentAt    DateTime?
  error     String?
  createdAt DateTime @default(now())
}

model DoctorAvailability {
  id           String   @id @default(uuid())
  doctorId     String
  dayOfWeek    Int      // 0=Sun, 1=Mon, ..., 6=Sat
  startTime    String   // "09:00"
  endTime      String   // "17:00"
  slotDuration Int      @default(15) // minutes
  isActive     Boolean  @default(true)
  orgId        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor User         @relation("DoctorAvailability", fields: [doctorId], references: [id])
  org    Organization @relation(fields: [orgId], references: [id])

  @@unique([doctorId, dayOfWeek])
}

model DoctorTimeOff {
  id        String   @id @default(uuid())
  doctorId  String
  date      DateTime // specific date off
  reason    String?
  orgId     String
  createdAt DateTime @default(now())

  doctor User         @relation("DoctorTimeOff", fields: [doctorId], references: [id])
  org    Organization @relation(fields: [orgId], references: [id])

  @@unique([doctorId, date])
}
